{% extends 'base.html.twig' %}

{% block title %}Félicitations{% endblock %}

{% block body %}
<div class="container mt-5 text-center">
    <h2>Félicitations 🎉</h2>
    <p>Votre chat <strong>{{ cat.name }}</strong> est prêt à rencontrer l'amour !</p>
    <img src="{{ asset('images/chats/image_' ~ cat.imageId ~ '.jpg') }}" alt="Chat" class="img-fluid rounded shadow" style="max-width: 300px;">
    <p class="mt-3">{{ cat.description }}</p>

    <h4 class="mt-4">Traits de caractère :</h4>
    <ul class="list-group w-50 mx-auto">
        {% for caractere in cat.caracteres %}
            <li class="list-group-item">{{ caractere.nom }}</li>
        {% endfor %}
    </ul>
</div>
{% endblock %}
