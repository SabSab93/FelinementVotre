{% extends 'base.html.twig' %}

{% block title %}Mettre à jour le chat{% endblock %}

{% block body %}
<div class="container mt-5">
    <h2 class="mb-4">Mettre à jour {{ cat.name }}</h2>
    <form action="{{ path('app_update_cat', {'id': cat.id}) }}" method="POST">
        <div class="mb-3">
            <label for="name" class="form-label">Nom du chat :</label>
            <input type="text" id="name" name="name" class="form-control" value="{{ cat.name }}" required>
        </div>

        <div class="mb-3">
            <label for="age" class="form-label">Âge :</label>
            <input type="number" id="age" name="age" class="form-control" value="{{ cat.age }}" required>
        </div>

        <div class="mb-3">
            <label for="breed" class="form-label">Race :</label>
            <input type="text" id="breed" name="breed" class="form-control" value="{{ cat.breed }}" required>
        </div>

        <div class="mb-3">
            <label for="gender" class="form-label">Sexe :</label>
            <select name="gender" id="gender" class="form-control">
                <option value="male" {% if cat.gender == 'male' %}selected{% endif %}>Mâle</option>
                <option value="female" {% if cat.gender == 'female' %}selected{% endif %}>Femelle</option>
                <option value="unknown" {% if cat.gender == 'unknown' %}selected{% endif %}>Non spécifié</option>
            </select>
        </div>

        <button type="submit" class="btn btn-warning">Mettre à jour</button>
    </form>
</div>
{% endblock %}
