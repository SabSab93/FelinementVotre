{% extends 'base.html.twig' %}

{% block title %}Ajouter un Chat{% endblock %}

{% block body %}
<div class="container mt-5">
    <h2>Ajouter un chat</h2>
    <form method="POST" action="{{ path('app_add_cat') }}">
        <div class="mb-3">
            <label for="name" class="form-label">Nom du chat</label>
            <input type="text" class="form-control" name="name" required>
        </div>
        <div class="mb-3">
            <label for="age" class="form-label">Âge</label>
            <input type="number" class="form-control" name="age" required>
        </div>
        <div class="mb-3">
            <label for="gender" class="form-label">Genre</label>
            <select name="gender" class="form-control" required>
                <option value="male">Mâle</option>
                <option value="female">Femelle</option>
            </select>
        </div>
        <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea class="form-control" name="description"></textarea>
        </div>

        <div class="mb-3">
            <label class="form-label">Traits de caractère (max 5) :</label>
            <div class="row">
                {% for caractere in caracteres %}
                    <div class="col-md-4">
                        <div class="form-check">
                            <input class="form-check-input caractere-checkbox" type="checkbox" name="caracteres[]" value="{{ caractere.id }}" id="caractere{{ caractere.id }}">
                            <label class="form-check-label" for="caractere{{ caractere.id }}">
                                {{ caractere.nom }}
                            </label>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Créer le chat</button>
    </form>
</div>

<script>
    document.querySelectorAll('.caractere-checkbox').forEach(checkbox => {
        checkbox.addEventListener('change', function () {
            const checked = document.querySelectorAll('.caractere-checkbox:checked');
            if (checked.length > 5) {
                this.checked = false;
                alert("Vous ne pouvez sélectionner que 5 traits maximum.");
            }
        });
    });
</script>
{% endblock %}
