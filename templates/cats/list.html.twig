{% extends 'base.html.twig' %}

{% block title %}Liste des Chats{% endblock %}

{% block body %}
    <h2>Liste des Chats</h2>
    <ul>
        {% for cat in cats %}
            <li>
                <strong>{{ cat.name }}</strong> - {{ cat.age }} ans - {{ cat.breed }} 
                ({{ cat.gender|default('Non spécifié') }})
            </li>
        {% else %}
            <li>Aucun chat enregistré pour le moment.</li>
        {% endfor %}
    </ul>
{% endblock %}

