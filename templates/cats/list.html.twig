{% extends 'base.html.twig' %}

{% block title %}Liste des Chats{% endblock %}

{% block body %}
<div class="container mt-5">
    <h2 class="mb-4">Liste des Chats</h2>
    {% for cat in cats %}
        <div class="mb-3">
            <p>Nom : {{ cat.name }}</p>
            <p>Genre : {{ cat.gender.value}}</p>
        </div>
    {% endfor %}
</div>
{% endblock %}
